rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(householdId) {
      return /databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid);
    }

    function isHouseholdMember(householdId) {
      return signedIn() && exists(memberPath(householdId));
    }

    function willBeHouseholdMember(householdId) {
      return signedIn() && existsAfter(memberPath(householdId));
    }

    function memberRole(householdId) {
      return get(memberPath(householdId)).data.role;
    }

    function canManageStock(householdId) {
      return isHouseholdMember(householdId) &&
        memberRole(householdId) in ['admin', 'member'];
    }

    match /households/{householdId} {
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string;

      allow read: if isHouseholdMember(householdId);

      allow update, delete: if isHouseholdMember(householdId)
        && memberRole(householdId) == 'admin';

      match /members/{memberId} {
        allow read: if signedIn()
          && (memberId == request.auth.uid || isHouseholdMember(householdId));

        allow create: if signedIn()
          && memberId == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == 'admin'
          && getAfter(/databases/$(database)/documents/households/$(householdId)).data.createdBy == request.auth.uid;

        allow update, delete: if isHouseholdMember(householdId)
          && memberRole(householdId) == 'admin';
      }

      match /stockItems/{stockItemId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update, delete: if canManageStock(householdId);
      }

      match /shoppingList/{itemId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update, delete: if isHouseholdMember(householdId);
      }

      match /recipes/{recipeId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update, delete: if canManageStock(householdId);
      }

      match /weeklyPlans/{weekId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update, delete: if canManageStock(householdId);
      }
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && userId == request.auth.uid;
      allow delete: if false;

      match /households/{householdId} {
        allow read: if signedIn() && userId == request.auth.uid;
        allow create, update, delete: if signedIn()
          && userId == request.auth.uid
          && (isHouseholdMember(householdId) || willBeHouseholdMember(householdId));
      }
    }
  }
}
